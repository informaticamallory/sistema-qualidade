# Configurações do ambiente
# Gere uma chave forte, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-secreta-aqui
FLASK_ENV=development

# JWT (autenticação). Se vazio, usa SECRET_KEY.
JWT_SECRET_KEY=
JWT_EXPIRES_HOURS=12

# CORS - origens permitidas, separadas por vírgula (ex.: http://localhost:5173,https://app.exemplo.com)
# Use '*' apenas em desenvolvimento.
CORS_ORIGINS=*

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_mallory

# Redis (opcional, para rate limiting)
REDIS_URL=memory://

# Logging
LOG_LEVEL=INFO
# Cloudflare R2 (opcional). Quando preenchido, evidências e certificados são enviados ao R2.
R2_ACCOUNT_ID=seu-account-id
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=sua-access-key-id
R2_SECRET_ACCESS_KEY=sua-secret-access-key
R2_BUCKET_NAME=nome-do-bucket
R2_PUBLIC_URL=https://sua-cdn-customizada.com