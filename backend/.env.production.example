# Producao - copie este arquivo para backend/.env e preencha os valores.
# Nunca versione o arquivo backend/.env.

FLASK_ENV=production
SECRET_KEY=gere-uma-chave-aleatoria-forte
JWT_SECRET_KEY=gere-outra-chave-aleatoria-forte
JWT_EXPIRES_HOURS=12

# URL exata do frontend publicado, sem barra final.
# Domínio real do frontend: https://cqm.malloryapp.com.br
CORS_ORIGINS=https://cqm.malloryapp.com.br

# MySQL provisionado no EasyPanel.
DB_HOST=host-do-mysql-easypanel
DB_PORT=3306
DB_USER=usuario-do-banco
DB_PASSWORD=senha-do-banco
DB_NAME=sistema_mallory

# Redis e logs
REDIS_URL=memory://
LOG_LEVEL=INFO

# Cloudflare R2
R2_ACCOUNT_ID=seu-account-id
R2_ENDPOINT_URL=https://seu-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=sua-access-key-id
R2_SECRET_ACCESS_KEY=sua-secret-access-key
R2_BUCKET_NAME=nome-do-bucket
R2_PUBLIC_URL=https://cdn.seu-dominio.com
