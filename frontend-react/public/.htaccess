Options -MultiViews
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]

# ── Cache ──
# Sem estas regras o sintoma volta a cada publicação: o index.html é quem
# aponta para os arquivos com hash no nome, e um index.html vindo do cache
# pede nomes que já não existem no servidor. A regra de reescrita acima então
# devolve o próprio index.html no lugar do .js, e o navegador recusa o módulo
# com "Expected a JavaScript module script but the server responded with a
# MIME type of text/html". Foi exatamente o que apareceu em produção.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/" ARQUIVO_COM_HASH=1
</IfModule>

<IfModule mod_headers.c>
    # O nome dos arquivos em /assets/ muda junto com o conteúdo, então podem
    # ficar em cache indefinidamente.
    Header set Cache-Control "public, max-age=31536000, immutable" env=ARQUIVO_COM_HASH

    # O index.html não tem hash no nome: precisa ser revalidado sempre, senão
    # continua apontando para a versão anterior dos assets.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
